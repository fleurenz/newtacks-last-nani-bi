<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvJobTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#1E293B"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="Hiring Welder" />

        <TextView
            android:id="@+id/tvCompanyName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#004A99"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp"
            tools:text="BuildRight Construction" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F1F5F9"
            android:layout_marginVertical="14dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_calendar"
                app:tint="#64748B"
                android:layout_marginEnd="10dp" />
            <TextView
                android:id="@+id/tvInterviewDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#475569"
                android:textSize="13sp"
                tools:text="August 28, 2026 at 10:00 AM" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_location"
                app:tint="#64748B"
                android:layout_marginEnd="10dp" />
            <TextView
                android:id="@+id/tvInterviewLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#475569"
                android:textSize="13sp"
                tools:text="Km 12, Davao City" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReschedule"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Reschedule"
                android:textAllCaps="false"
                android:textColor="#EF4444"
                app:strokeColor="#EF4444"
                app:cornerRadius="10dp"
                android:layout_marginEnd="8dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAccept"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.2"
                android:text="Accept Date"
                android:textAllCaps="false"
                android:textStyle="bold"
                app:backgroundTint="#004A99"
                app:cornerRadius="10dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvResponseStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Waiting for company response..."
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:textStyle="italic"
            android:visibility="gone" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
