<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/jobDetailsBottomSheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rounded_top_white"
    android:backgroundTint="#FFFFFF"
    android:elevation="16dp"
    app:behavior_hideable="true"
    app:behavior_peekHeight="90dp"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Client Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="16dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivClientProfileBS"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_person_placeholder"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/CircleImage"
                android:background="#F1F5F9"
                android:padding="2dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1"
                android:layout_marginStart="16dp">

                <TextView
                    android:id="@+id/tvClientNameBS"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Client Name"
                    android:textColor="#000000"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_location"
                        app:tint="#EF4444" />
                    <TextView
                        android:id="@+id/tvDistanceBS"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- km away"
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:layout_marginStart="4dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F1F5F9" />

        <!-- Job Info Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Job Details"
                android:textColor="#000000"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="20dp" />

            <!-- Service Type -->
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Service Type" android:textColor="#94A3B8" android:textSize="14sp" />
                <TextView android:id="@+id/tvServiceTypeBS" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="Plumbing Repair" android:textColor="#0F325E" android:textSize="14sp" android:textStyle="bold" />
            </RelativeLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9" android:layout_marginVertical="12dp" />

            <!-- Address -->
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Address" android:textColor="#94A3B8" android:textSize="14sp" />
                <TextView android:id="@+id/tvAddressBS" android:layout_width="180dp" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="123 Wazzup St." android:textColor="#1C6EC6" android:textSize="14sp" android:textStyle="bold" android:gravity="end" />
            </RelativeLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9" android:layout_marginVertical="12dp" />

            <!-- Time -->
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Time" android:textColor="#94A3B8" android:textSize="14sp" />
                <TextView android:id="@+id/tvTimeBS" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="10:00 AM" android:textColor="#0F325E" android:textSize="14sp" android:textStyle="bold" />
            </RelativeLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9" android:layout_marginVertical="12dp" />

            <!-- Date -->
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Scheduled Date" android:textColor="#94A3B8" android:textSize="14sp" />
                <TextView android:id="@+id/tvDateBS" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="September 21, 2026" android:textColor="#0F325E" android:textSize="14sp" android:textStyle="bold" />
            </RelativeLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9" android:layout_marginVertical="12dp" />

            <!-- Image Link -->
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Image" android:textColor="#94A3B8" android:textSize="14sp" />
                <TextView android:id="@+id/btnViewImagesBS" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="View Image(s)" android:textColor="#1C6EC6" android:textSize="14sp" android:textStyle="bold" android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true" />
            </RelativeLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9" android:layout_marginVertical="12dp" />

            <!-- Rate -->
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rate" android:textColor="#94A3B8" android:textSize="14sp" />
                <TextView android:id="@+id/tvRateBS" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="P750/per day" android:textColor="#0F325E" android:textSize="14sp" android:textStyle="bold" />
            </RelativeLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9" android:layout_marginVertical="12dp" />

            <!-- Description -->
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Description" android:textColor="#94A3B8" android:textSize="14sp" />
                <TextView android:id="@+id/tvDescriptionBS" android:layout_width="180dp" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="Detailed info..." android:textColor="#0F325E" android:textSize="13sp" android:gravity="end" />
            </RelativeLayout>
        </LinearLayout>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeclineBS"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Decline"
                android:textAllCaps="false"
                android:textColor="#EF4444"
                android:textStyle="bold"
                app:backgroundTint="#FEE2E2"
                app:cornerRadius="12dp"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAcceptBS"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1.2"
                android:text="Accept Job"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:backgroundTint="#22C55E"
                app:cornerRadius="12dp" />
        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>