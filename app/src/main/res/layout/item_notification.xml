<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardNotif"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Unread Indicator (Vertical bar) -->
        <View
            android:id="@+id/viewUnreadIndicator"
            android:layout_width="4dp"
            android:layout_height="0dp"
            android:layout_alignTop="@+id/layoutNotifContent"
            android:layout_alignBottom="@+id/layoutNotifContent"
            android:background="#004A99"
            android:visibility="visible" />

        <LinearLayout
            android:id="@+id/layoutNotifContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivNotifIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_notifications"
                app:tint="#004A99"
                android:padding="8dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="#EBF2FF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:id="@+id/tvNotifTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#1E293B"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Notification Title" />

                <TextView
                    android:id="@+id/tvNewBanner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_green1"
                    android:backgroundTint="#EF4444"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:text="NEW"
                    android:textColor="#FFFFFF"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tvNotifMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"
                    tools:text="This is the message detail." />

                <TextView
                    android:id="@+id/tvNotifTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    android:layout_marginTop="4dp"
                    tools:text="Just now" />
            </LinearLayout>

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_arrow_right"
                app:tint="#CBD5E1" />

        </LinearLayout>
    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>
