<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="24dp">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_close"
        app:tint="#DC2626"
        android:background="@drawable/bg_circle"
        android:backgroundTint="#FEE2E2"
        android:padding="16dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Completion Refused"
        android:textColor="#1E293B"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="The client has rejected your completion request."
        android:textColor="#64748B"
        android:textSize="14sp"
        android:layout_gravity="center"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reason"
        android:textColor="#64748B"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textAllCaps="true" />

    <TextView
        android:id="@+id/tvRejectionReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Job not fully completed"
        android:textColor="#1E293B"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Details"
        android:textColor="#64748B"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textAllCaps="true" />

    <TextView
        android:id="@+id/tvRejectionDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pipe is still leaking..."
        android:textColor="#1E293B"
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/labelEvidence"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Evidence"
        android:textColor="#64748B"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textAllCaps="true"
        android:visibility="gone" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivRejectionEvidence"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:scaleType="centerCrop"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp"
        android:visibility="gone"
        app:shapeAppearanceOverlay="@style/RoundedSquare" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAcknowledge"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="I'll fix it"
        android:textAllCaps="false"
        android:textStyle="bold"
        app:cornerRadius="14dp"
        app:backgroundTint="#0F325E" />

</LinearLayout>