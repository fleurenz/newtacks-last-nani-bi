<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#004A99">

    <!-- TOOLBAR -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="#FFFFFF"
        app:title="Report User"
        app:titleTextColor="#FFFFFF"
        app:titleTextAppearance="@style/ToolbarTitleStyle">

        <ImageButton
            android:id="@+id/btnToolbarMore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginEnd="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_more_vert"
            app:tint="#FFFFFF" />
    </androidx.appcompat.widget.Toolbar>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_top_white"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvReportContext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reporting: John Doe"
                android:textColor="#64748B"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvReporterInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reporter: Jane Smith"
                android:textColor="#64748B"
                android:textSize="13sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="What is the issue?"
                android:textColor="#1E293B"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select the reason that best describes your report"
                android:textColor="#64748B"
                android:textSize="13sp"
                android:layout_marginBottom="16dp" />

            <RadioGroup
                android:id="@+id/rgReportReasons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rbUnprofessional"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:text="Unprofessional behavior"
                    android:button="@null"
                    android:drawableEnd="?android:attr/listChoiceIndicatorSingle"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_card"
                    android:layout_marginBottom="10dp"
                    android:textColor="#1E293B"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/rbScam"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:text="Scam or Fraudulent activity"
                    android:button="@null"
                    android:drawableEnd="?android:attr/listChoiceIndicatorSingle"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_card"
                    android:layout_marginBottom="10dp"
                    android:textColor="#1E293B"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/rbMalicious"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:text="Malicious messages / Harassment"
                    android:button="@null"
                    android:drawableEnd="?android:attr/listChoiceIndicatorSingle"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_card"
                    android:layout_marginBottom="10dp"
                    android:textColor="#1E293B"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/rbNoShow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:text="No-show / Abandonment"
                    android:button="@null"
                    android:drawableEnd="?android:attr/listChoiceIndicatorSingle"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_card"
                    android:layout_marginBottom="10dp"
                    android:textColor="#1E293B"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/rbInappropriate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:text="Inappropriate content"
                    android:button="@null"
                    android:drawableEnd="?android:attr/listChoiceIndicatorSingle"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_card"
                    android:layout_marginBottom="10dp"
                    android:textColor="#1E293B"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/rbOther"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:text="Other"
                    android:button="@null"
                    android:drawableEnd="?android:attr/listChoiceIndicatorSingle"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_card"
                    android:layout_marginBottom="24dp"
                    android:textColor="#1E293B"
                    android:textStyle="bold" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Additional Details"
                android:textColor="#1E293B"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/etReportDescription"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="@drawable/bg_card"
                android:gravity="top"
                android:hint="Provide more information about the issue..."
                android:padding="16dp"
                android:textSize="14sp"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add evidence (Screenshots/Photos)"
                android:textColor="#1E293B"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <FrameLayout
                android:id="@+id/btnUploadReportEvidence"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:background="@drawable/bg_image_placeholder"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:id="@+id/ivReportEvidence"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_plus"
                    app:tint="#004A99" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FEF3C7"
                android:padding="16dp"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Our team will review this report within 24-48 hours. Misuse of the reporting system may lead to account suspension."
                    android:textColor="#D97706"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitUserReport"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="Submit report"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:backgroundTint="#B91C1C"
                app:cornerRadius="16dp"
                android:layout_marginBottom="32dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Loading Overlay -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">
        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="#FFFFFF" />
    </FrameLayout>

</LinearLayout>