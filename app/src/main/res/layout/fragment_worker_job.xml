<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F325E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Status Bar Spacer -->
        <View
            android:id="@+id/statusBarSpacer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="#0F325E" />

        <!-- ===== HEADER ===== -->
        <RelativeLayout
            android:id="@+id/layoutHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:letterSpacing="0.05"
                android:text="JOB REQUEST"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnNotifications"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_notifications"/>
        </RelativeLayout>

        <!-- ===== MAIN CONTENT CONTAINER ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/rounded_top_white"
            android:orientation="vertical">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- CONTENT (shown when job exists) -->
                    <LinearLayout
                        android:id="@+id/layoutContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="24dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <!-- JOB TITLE AREA -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="24dp"
                            android:layout_marginBottom="24dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvJobTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="#0F325E"
                                    android:textSize="22sp"
                                    android:textStyle="bold"
                                    tools:text="Plumbing Repair" />

                                <TextView
                                    android:id="@+id/tvJobDateTop"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:textColor="#64748B"
                                    android:textSize="12sp"
                                    tools:text="September 21, 2026" />
                            </LinearLayout>

                            <ImageButton
                                android:id="@+id/btnMoreOptions"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:src="@drawable/ic_more_vert"
                                app:tint="#0F325E" />
                        </RelativeLayout>

                        <!-- CLIENT INFO SECTION -->
                        <LinearLayout
                            android:id="@+id/layoutClientSection"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="24dp"
                            android:layout_marginBottom="24dp">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/ivClientProfile"
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_person_placeholder"
                                app:shapeAppearanceOverlay="@style/CircleImage"
                                app:strokeColor="#F1F5F9"
                                app:strokeWidth="1dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvClientDetailName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Maison Baga"
                                    android:textColor="#1E293B"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:layout_marginTop="2dp">
                                    <ImageView
                                        android:layout_width="12dp"
                                        android:layout_height="12dp"
                                        android:src="@drawable/ic_location"
                                        app:tint="#EF4444" />
                                    <TextView
                                        android:id="@+id/tvClientDistance"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="4dp"
                                        android:text="10km away"
                                        android:textColor="#64748B"
                                        android:textSize="11sp" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Profile & Message Buttons -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/btnViewClientProfile"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:layout_marginEnd="8dp"
                                app:cardBackgroundColor="#FFF1E2"
                                app:cardCornerRadius="8dp"
                                app:cardElevation="0dp"
                                android:clickable="true"
                                android:focusable="true">
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:paddingHorizontal="10dp">
                                    <ImageView
                                        android:layout_width="14dp"
                                        android:layout_height="14dp"
                                        android:src="@drawable/ic_person"
                                        app:tint="#F59E0B" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="4dp"
                                        android:text="View Profile"
                                        android:textColor="#F59E0B"
                                        android:textSize="10sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <FrameLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">

                                <com.google.android.material.card.MaterialCardView
                                    android:id="@+id/btnMessageClient"
                                    android:layout_width="wrap_content"
                                    android:layout_height="40dp"
                                    app:cardBackgroundColor="#EBF2FF"
                                    app:cardCornerRadius="8dp"
                                    app:cardElevation="0dp"
                                    android:clickable="true"
                                    android:focusable="true">
                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:paddingHorizontal="10dp">
                                        <ImageView
                                            android:layout_width="16dp"
                                            android:layout_height="16dp"
                                            android:src="@drawable/message_icon" />
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="4dp"
                                            android:text="Message"
                                            android:textColor="#0F325E"
                                            android:textSize="10sp"
                                            android:textStyle="bold" />
                                    </LinearLayout>
                                </com.google.android.material.card.MaterialCardView>

                                <!-- Notification Badge -->
                                <TextView
                                    android:id="@+id/tvMessageBadgeWorker"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="top|end"
                                    android:layout_marginTop="-4dp"
                                    android:layout_marginEnd="-4dp"
                                    android:background="@drawable/bg_circle"
                                    android:backgroundTint="#EF4444"
                                    android:gravity="center"
                                    android:textColor="#FFFFFF"
                                    android:textSize="9sp"
                                    android:textStyle="bold"
                                    android:visibility="gone"
                                    tools:text="1"
                                    tools:visibility="visible" />
                            </FrameLayout>
                        </LinearLayout>

                        <!-- PROGRESS BAR SECTION (Worker's Version) -->
                        <LinearLayout
                            android:id="@+id/layoutProgress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingHorizontal="24dp"
                            android:layout_marginBottom="32dp">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <!-- Track Background -->
                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="4dp"
                                    android:layout_centerVertical="true"
                                    android:layout_marginHorizontal="16dp"
                                    android:background="#E2E8F0" />
                                <!-- Active Track -->
                                <View
                                    android:id="@+id/progressTrackActive"
                                    android:layout_width="0dp"
                                    android:layout_height="4dp"
                                    android:layout_centerVertical="true"
                                    android:layout_marginStart="16dp"
                                    android:background="#0F325E" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">

                                    <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                                        <ImageView android:id="@+id/step1" android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="center" android:background="@drawable/bg_step_circle_active" android:padding="6dp" android:src="@drawable/ic_search" app:tint="#FFFFFF" />
                                    </FrameLayout>
                                    <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                                        <ImageView android:id="@+id/step2" android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="center" android:background="@drawable/bg_step_circle_inactive" android:padding="6dp" android:src="@drawable/ic_location" app:tint="#94A3B8" />
                                    </FrameLayout>
                                    <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                                        <ImageView android:id="@+id/step3" android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="center" android:background="@drawable/bg_step_circle_inactive" android:padding="6dp" android:src="@drawable/ic_check_circle" app:tint="#94A3B8" />
                                    </FrameLayout>
                                    <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                                        <ImageView android:id="@+id/step4" android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="center" android:background="@drawable/bg_step_circle_inactive" android:padding="6dp" android:src="@drawable/ic_check" app:tint="#94A3B8" />
                                    </FrameLayout>

                                </LinearLayout>
                            </RelativeLayout>

                            <TextView
                                android:id="@+id/tvProgressStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center"
                                android:text="Found"
                                android:textColor="#0F325E"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- JOB DETAILS CARD -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="24dp"
                            android:layout_marginBottom="24dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="4dp"
                            app:strokeWidth="0dp"
                            android:backgroundTint="#FFFFFF">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="20dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Job Details"
                                    android:textColor="#1E293B"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:layout_marginBottom="20dp" />

                                <!-- Service Type -->
                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:paddingVertical="8dp">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Service Type"
                                        android:textColor="#94A3B8"
                                        android:textSize="11sp" />
                                    <TextView
                                        android:id="@+id/tvServiceType"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_alignParentEnd="true"
                                        android:text="Plumbing Repair"
                                        android:textColor="#0F325E"
                                        android:textSize="13sp"
                                        android:textStyle="bold" />
                                </RelativeLayout>
                                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9" />

                                <!-- Address -->
                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:paddingVertical="8dp">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Address"
                                        android:textColor="#94A3B8"
                                        android:textSize="11sp" />
                                    <TextView
                                        android:id="@+id/tvAddress"
                                        android:layout_width="180dp"
                                        android:layout_height="wrap_content"
                                        android:layout_alignParentEnd="true"
                                        android:text="123 Wazzup St. Quimpo Blvd"
                                        android:textColor="#0F325E"
                                        android:textSize="13sp"
                                        android:textStyle="bold"
                                        android:gravity="end" />
                                </RelativeLayout>
                                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9" />

                                <!-- Time -->
                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:paddingVertical="8dp">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Time"
                                        android:textColor="#94A3B8"
                                        android:textSize="11sp" />
                                    <TextView
                                        android:id="@+id/tvTime"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_alignParentEnd="true"
                                        android:text="10:00 AM"
                                        android:textColor="#0F325E"
                                        android:textSize="13sp"
                                        android:textStyle="bold" />
                                </RelativeLayout>
                                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9" />

                                <!-- Scheduled Date -->
                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:paddingVertical="8dp">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Scheduled Date"
                                        android:textColor="#94A3B8"
                                        android:textSize="11sp" />
                                    <TextView
                                        android:id="@+id/tvDate"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_alignParentEnd="true"
                                        android:text="September 21, 2026"
                                        android:textColor="#0F325E"
                                        android:textSize="13sp"
                                        android:textStyle="bold" />
                                </RelativeLayout>
                                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9" />

                                <!-- Image -->
                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:paddingVertical="8dp">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Image"
                                        android:textColor="#94A3B8"
                                        android:textSize="11sp" />
                                    <TextView
                                        android:id="@+id/btnViewImages"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_alignParentEnd="true"
                                        android:text="View Image(s)"
                                        android:textColor="#0F325E"
                                        android:textSize="13sp"
                                        android:textStyle="bold"
                                        android:background="?attr/selectableItemBackground" />
                                </RelativeLayout>
                                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9" />

                                <!-- Rate -->
                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:paddingVertical="8dp">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Rate"
                                        android:textColor="#94A3B8"
                                        android:textSize="11sp" />
                                    <TextView
                                        android:id="@+id/tvRate"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_alignParentEnd="true"
                                        android:text="₱750/per day"
                                        android:textColor="#0F325E"
                                        android:textSize="13sp"
                                        android:textStyle="bold" />
                                </RelativeLayout>
                                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9" />

                                <!-- Description -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:paddingVertical="8dp">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Description"
                                        android:textColor="#94A3B8"
                                        android:textSize="11sp" />
                                    <TextView
                                        android:id="@+id/tvDescription"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="Urgent pipe leak under kitchen sink, water pooling on floor"
                                        android:textColor="#0F325E"
                                        android:textSize="12sp"
                                        android:textStyle="bold"
                                        android:gravity="end"
                                        android:layout_marginStart="16dp" />
                                </LinearLayout>

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <!-- ===== EMPTY STATE ===== -->
                    <LinearLayout
                        android:id="@+id/layoutEmptyState"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:layout_marginBottom="24dp"
                            android:alpha="0.3"
                            android:src="@drawable/ic_inbox" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No Active Job"
                            android:textColor="#1E293B"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="You have no job assigned yet.&#10;Check the feed for available jobs."
                            android:textColor="#94A3B8"
                            android:textSize="13sp"
                            android:gravity="center"
                            android:lineSpacingExtra="4dp" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <!-- ===== BOTTOM BUTTONS AREA ===== -->
            <LinearLayout
                android:id="@+id/layoutBottomButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:elevation="16dp"
                android:orientation="horizontal"
                android:padding="20dp"
                android:weightSum="2"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNavigateToMap"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="0.8"
                    android:layout_marginEnd="10dp"
                    android:text="Map"
                    android:textAllCaps="false"
                    android:textColor="#0F325E"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:strokeColor="#0F325E"
                    app:strokeWidth="1dp"
                    app:icon="@drawable/ic_navigate_location"
                    app:iconGravity="textStart"
                    app:iconTint="#0F325E" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMainAction"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1.2"
                    android:text="Start heading there"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="#0F325E"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_location"
                    app:iconGravity="textStart"
                    app:iconTint="#FFFFFF" />

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- Loading Overlay -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">
        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="#FFFFFF" />
    </FrameLayout>

</FrameLayout>
