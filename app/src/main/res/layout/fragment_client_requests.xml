<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#004A99">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Status Bar Spacer -->
        <View
            android:id="@+id/statusBarSpacer"
            android:layout_width="match_parent"
            android:layout_height="0dp" />

        <!-- HEADER -->
        <RelativeLayout
            android:id="@+id/layoutHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <!-- Standard Title -->
            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="REQUEST"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <!-- Distance Display (Visible when worker heading) -->
            <LinearLayout
                android:id="@+id/layoutDistanceHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvDistanceBigValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3.1"
                        android:textColor="#FFFFFF"
                        android:textSize="96sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/tvDistanceBigUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        android:layout_marginStart="4dp"
                        android:text="km"
                        android:textColor="#FFFFFF"
                        android:textSize="28sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-12dp"
                    android:text="away"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:alpha="0.8" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnNotifications"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_notifications"
                app:tint="#FFFFFF" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/rounded_top_white">

            <!-- EMPTY STATE -->
            <LinearLayout
                android:id="@+id/layoutEmptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">
                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_inbox"
                    android:alpha="0.2"
                    android:layout_marginBottom="16dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No active requests yet"
                    android:textColor="#64748B"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/layoutContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Title Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginBottom="24dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:id="@+id/tvRequestTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:text="Job Title"
                                android:textColor="#004A99"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <ImageButton
                                android:id="@+id/btnMoreOptions"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:src="@drawable/ic_more_vert"
                                app:tint="#004A99" />
                        </RelativeLayout>

                        <TextView
                            android:id="@+id/tvRequestDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="September 21, 2026"
                            android:textColor="#64748B"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Standard Progress Bar (5 Steps) -->
                    <LinearLayout
                        android:id="@+id/layoutStandardProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="32dp"
                        android:paddingHorizontal="20dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <!-- Track Background -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="4dp"
                                android:layout_centerVertical="true"
                                android:background="#E2E8F0"
                                android:layout_marginHorizontal="16dp" />
                            <!-- Active Track -->
                            <View
                                android:id="@+id/progressTrackActive"
                                android:layout_width="0dp"
                                android:layout_height="4dp"
                                android:layout_centerVertical="true"
                                android:background="#004A99"
                                android:layout_marginStart="16dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">
                                <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                                    <ImageView android:id="@+id/step1" android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="center" android:background="@drawable/bg_step_circle_active" android:src="@drawable/ic_search" android:padding="6dp" />
                                </FrameLayout>
                                <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                                    <ImageView android:id="@+id/step2" android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="center" android:background="@drawable/bg_step_circle_inactive" android:src="@drawable/ic_check" android:padding="6dp" />
                                </FrameLayout>
                                <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                                    <ImageView android:id="@+id/step3" android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="center" android:background="@drawable/bg_step_circle_inactive" android:src="@drawable/ic_location" android:padding="6dp" />
                                </FrameLayout>
                                <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                                    <ImageView android:id="@+id/step4" android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="center" android:background="@drawable/bg_step_circle_inactive" android:src="@drawable/ic_hammer" android:padding="6dp" />
                                </FrameLayout>
                                <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                                    <ImageView android:id="@+id/step5" android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="center" android:background="@drawable/bg_step_circle_inactive" android:src="@drawable/ic_bubble_alert" android:padding="6dp" />
                                </FrameLayout>
                            </LinearLayout>
                        </RelativeLayout>

                        <TextView
                            android:id="@+id/tvProgressStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Searching..."
                            android:textColor="#004A99"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:textAlignment="center"
                            android:maxWidth="80dp"
                            android:lineSpacingExtra="1dp" />
                    </LinearLayout>


                    <!-- WORKER SECTION -->
                    <LinearLayout
                        android:id="@+id/layoutWorker"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="32dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivWorkerProfile"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_user_placeholder"
                            app:shapeAppearanceOverlay="@style/CircleImage" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvWorkerName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Worker Name"
                                android:textColor="#1E293B"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">
                                <ImageView android:layout_width="10dp" android:layout_height="10dp" android:src="@drawable/ic_location" app:tint="#EF4444" />
                                <TextView
                                    android:id="@+id/tvWorkerDistance"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="10km away"
                                    android:textColor="#64748B"
                                    android:textSize="11sp"
                                    android:layout_marginStart="3dp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Buttons side-by-side -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnViewProfile"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="72dp"
                                android:layout_height="48dp"
                                android:text="View Profile"
                                android:textColor="#D97706"
                                android:textSize="9sp"
                                android:padding="0dp"
                                app:backgroundTint="#FEF3C7"
                                app:cornerRadius="8dp"
                                app:icon="@drawable/ic_nav_account"
                                app:iconSize="16dp"
                                app:iconTint="#D97706"
                                app:iconGravity="top"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnMessageWorkerSmall"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="64dp"
                                android:layout_height="48dp"
                                android:layout_marginStart="8dp"
                                android:text="Message"
                                android:textColor="#64748B"
                                android:textSize="9sp"
                                android:padding="0dp"
                                app:backgroundTint="#F1F5F9"
                                app:cornerRadius="8dp"
                                app:icon="@drawable/message"
                                app:iconSize="16dp"
                                app:iconTint="#64748B"
                                app:iconGravity="top"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- DETAILS LIST IN A CARD -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="6dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:strokeWidth="0dp"
                        android:layout_marginHorizontal="4dp"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Job Details"
                                android:textColor="#1E293B"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="12dp" />

                            <!-- Rows with dividers -->
                            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9" />

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingVertical="10dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Service Type" android:textColor="#94A3B8" android:textSize="11sp" />
                                <TextView android:id="@+id/tvDetailService" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Plumbing Repair" android:textColor="#004A99" android:textSize="12sp" android:textStyle="bold" android:gravity="end" />
                            </LinearLayout>
                            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9" />

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingVertical="10dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Address" android:textColor="#94A3B8" android:textSize="11sp" />
                                <TextView android:id="@+id/tvDetailAddress" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="123 Wazzup St. Quimpo Blvd" android:textColor="#004A99" android:textSize="12sp" android:textStyle="bold" android:gravity="end" />
                            </LinearLayout>
                            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9" />

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingVertical="10dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Time" android:textColor="#94A3B8" android:textSize="11sp" />
                                <TextView android:id="@+id/tvDetailTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="10:00 AM" android:textColor="#004A99" android:textSize="12sp" android:textStyle="bold" android:gravity="end" />
                            </LinearLayout>
                            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9" />

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingVertical="10dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Scheduled Date" android:textColor="#94A3B8" android:textSize="11sp" />
                                <TextView android:id="@+id/tvDetailDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="September 21, 2026" android:textColor="#004A99" android:textSize="12sp" android:textStyle="bold" android:gravity="end" />
                            </LinearLayout>
                            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9" />

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingVertical="10dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Image" android:textColor="#94A3B8" android:textSize="11sp" />
                                <TextView android:id="@+id/btnViewImages" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="View Image(s)" android:textColor="#004A99" android:textSize="12sp" android:textStyle="bold" android:gravity="end" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground" />
                            </LinearLayout>
                            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9" />

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingVertical="10dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rate" android:textColor="#94A3B8" android:textSize="11sp" />
                                <TextView android:id="@+id/tvDetailRate" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="P750/per day" android:textColor="#004A99" android:textSize="12sp" android:textStyle="bold" android:gravity="end" />
                            </LinearLayout>
                            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9" />

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingVertical="10dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Description" android:textColor="#94A3B8" android:textSize="11sp" android:layout_marginBottom="6dp" />
                                <TextView android:id="@+id/tvDetailDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Urgent pipe leak under kitchen sink, water pooling on floor" android:textColor="#004A99" android:textSize="12sp" android:textStyle="bold" android:gravity="end" />
                            </LinearLayout>

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

            <!-- STICKY BOTTOM BUTTONS -->
            <LinearLayout
                android:id="@+id/layoutBottomButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp"
                android:paddingBottom="24dp"
                android:paddingTop="8dp"
                android:visibility="gone"
                tools:visibility="visible">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReject"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Reject / Return"
                    android:textColor="#DC2626"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="#FEE2E2"
                    app:cornerRadius="12dp"
                    app:strokeColor="#DC2626"
                    app:strokeWidth="1dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfirm"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Confirm Work"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="#16A34A"
                    app:cornerRadius="12dp"/>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Floating P button (Optional, from screenshot) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:src="@drawable/ic_check"
        app:tint="#FFFFFF"
        app:backgroundTint="#E11D48"
        android:visibility="gone" />

    <!-- Loading Overlay -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:background="@drawable/bg_card"
            android:layout_gravity="center">
            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminateTint="#004A99"
                android:layout_marginBottom="16dp" />
            <TextView
                android:id="@+id/tvLoadingMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Processing..."
                android:textColor="#1E293B"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>