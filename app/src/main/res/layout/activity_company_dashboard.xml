<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/companyRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8">

    <FrameLayout
        android:id="@+id/companyFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="88dp" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabChat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="100dp"
        app:maxImageSize="40dp"
        android:scaleType="centerInside"
        app:srcCompat="@drawable/chatbot_logo"
        app:tint="@null"
        app:backgroundTint="#FFFFFF"
        android:contentDescription="Chat with AI" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/companyBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_nav"
        app:backgroundTint="@null"
        android:elevation="12dp"
        app:menu="@menu/company_bottom_menu"
        app:itemIconSize="22dp"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:labelVisibilityMode="labeled"
        app:itemPaddingTop="12dp"
        app:itemPaddingBottom="12dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>