<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC">

    <!-- HEADER / BRANDING -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:padding="20dp"
        android:gravity="center_vertical"
        android:elevation="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="mangopay"
            android:textColor="#FF5A5F"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_key"
            app:tint="#64748B"
            android:contentDescription="Secure Payment"/>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- TRANSACTION SUMMARY -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Payment Summary"
                android:textColor="#1E293B"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvPaymentJobTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Plumbing Repair"
                        android:textColor="#1E293B"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvPaymentWorkerName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Worker: John Doe"
                        android:textColor="#64748B"
                        android:textSize="13sp"
                        android:layout_marginTop="4dp"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F5F9"
                        android:layout_marginVertical="16dp"/>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Amount"
                            android:textColor="#1E293B"
                            android:textSize="14sp"/>
                        <TextView
                            android:id="@+id/tvPaymentAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="₱500.00"
                            android:textColor="#004A99"
                            android:textSize="20sp"
                            android:textStyle="bold"/>
                    </RelativeLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- PAYMENT METHODS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Payment Method"
                android:textColor="#1E293B"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <RadioGroup
                android:id="@+id/rgPaymentMethods"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rbCard"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:text="Credit or Debit Card"
                    android:button="@null"
                    android:drawableStart="@drawable/ic_inbox"
                    android:drawablePadding="16dp"
                    android:drawableEnd="?android:attr/listChoiceIndicatorSingle"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_card"
                    android:layout_marginBottom="12dp"
                    android:textColor="#1E293B"
                    android:textStyle="bold"
                    android:checked="true"
                    app:buttonTint="#004A99"/>

                <RadioButton
                    android:id="@+id/rbGCash"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:text="GCash / E-Wallet"
                    android:button="@null"
                    android:drawableStart="@drawable/ic_nav_account"
                    android:drawablePadding="16dp"
                    android:drawableEnd="?android:attr/listChoiceIndicatorSingle"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_card"
                    android:layout_marginBottom="12dp"
                    android:textColor="#1E293B"
                    android:textStyle="bold"
                    app:buttonTint="#004A99"/>
            </RadioGroup>

            <!-- CARD DETAILS (Shown if Card selected) -->
            <LinearLayout
                android:id="@+id/layoutCardDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp">

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="Card Number"
                    android:inputType="number"
                    android:background="@drawable/bg_card"
                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <EditText
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:hint="MM/YY"
                        android:background="@drawable/bg_card"
                        android:paddingHorizontal="16dp"
                        android:layout_marginEnd="6dp"/>
                    <EditText
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:hint="CVV"
                        android:inputType="numberPassword"
                        android:background="@drawable/bg_card"
                        android:paddingHorizontal="16dp"
                        android:layout_marginStart="6dp"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your payment is secured by Mangopay 256-bit encryption. Stract does not store your card details."
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:layout_marginTop="24dp"
                android:gravity="center"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- BOTTOM ACTION -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:padding="20dp"
        android:elevation="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPayNow"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Pay ₱500.00 Now"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:backgroundTint="#004A99"/>
    </LinearLayout>

    <!-- SUCCESS OVERLAY -->
    <FrameLayout
        android:id="@+id/layoutSuccess"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/ic_check_circle"
                app:tint="#22C55E"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Payment Successful"
                android:textColor="#1E293B"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Redirecting to receipt..."
                android:textColor="#64748B"
                android:layout_marginTop="8dp"/>
        </LinearLayout>
    </FrameLayout>

    <!-- LOADING OVERLAY -->
    <FrameLayout
        android:id="@+id/paymentLoadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3FFFFFF"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">
        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="#004A99" />
    </FrameLayout>

</LinearLayout>