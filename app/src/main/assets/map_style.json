{
  "version": 8,
  "name": "Local OSM Style",
  "glyphs": "https://demotiles.maplibre.org/font/{fontstack}/{range}.pbf",
  "sources": {
    "local-osm": {
      "type": "vector",
      "tiles": [
        "http://localhost:8888/{z}/{x}/{y}"
      ],
      "minzoom": 0,
      "maxzoom": 14
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#E5E7EB"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "local-osm",
      "source-layer": "water",
      "paint": {
        "fill-color": "#93C5FD"
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "local-osm",
      "source-layer": "building",
      "paint": {
        "fill-color": "#D1D5DB"
      }
    },
    {
      "id": "road",
      "type": "line",
      "source": "local-osm",
      "source-layer": "transportation",
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": 2
      }
    },
    {
      "id": "road-label",
      "type": "symbol",
      "source": "local-osm",
      "source-layer": "transportation_name",
      "layout": {
        "text-field": "{name}",
        "text-size": 12,
        "symbol-placement": "line"
      },
      "paint": {
        "text-color": "#1E293B",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1
      }
    },
    {
      "id": "place-label",
      "type": "symbol",
      "source": "local-osm",
      "source-layer": "place",
      "layout": {
        "text-field": "{name}",
        "text-size": 16
      },
      "paint": {
        "text-color": "#1E293B",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 2
      }
    }
  ]
}